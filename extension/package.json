{
  "name": "pebble",
  "displayName": "Pebble",
  "description": "Un senior engineer nel tuo editor: guida, rivede e consiglia test. Il codice lo scrivi tu.",
  "version": "0.7.11",
  "publisher": "lordkenzo",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#14182a",
    "theme": "dark"
  },
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In modalità con restrizioni Pebble funziona (percorso, fumetto, review), ma non lancia il comando dei test: eseguirebbe codice della cartella. Considera attendibile la cartella per far spuntare i compiti in automatico.",
      "restrictedConfigurations": [
        "pebble.path.testCommand"
      ]
    },
    "virtualWorkspaces": false
  },
  "categories": [
    "Linters",
    "Education",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pebble.start",
        "title": "Inizia: racconta il progetto a Pebble",
        "category": "Pebble"
      },
      {
        "command": "pebble.reviewFile",
        "title": "Rivedi il file",
        "category": "Pebble"
      },
      {
        "command": "pebble.setApiKey",
        "title": "Imposta la chiave API",
        "category": "Pebble"
      },
      {
        "command": "pebble.clearReview",
        "title": "Rimuovi le note",
        "category": "Pebble"
      },
      {
        "command": "pebble.openSettings",
        "title": "Impostazioni",
        "category": "Pebble",
        "icon": "$(gear)"
      },
      {
        "command": "pebble.setLevel",
        "title": "Imposta il mio livello di esperienza",
        "category": "Pebble"
      },
      {
        "command": "pebble.showSpend",
        "title": "Mostra la spesa",
        "category": "Pebble"
      },
      {
        "command": "pebble.resetSpend",
        "title": "Azzera il conteggio della spesa",
        "category": "Pebble"
      },
      {
        "command": "pebble.init",
        "title": "Leggi il bootstrap e proponi il piano",
        "category": "Pebble"
      },
      {
        "command": "pebble.next",
        "title": "Qual è il prossimo passo?",
        "category": "Pebble"
      },
      {
        "command": "pebble.tests",
        "title": "Test consigliati per il file aperto",
        "category": "Pebble"
      },
      {
        "command": "pebble.clearChat",
        "title": "Pulisci la conversazione",
        "category": "Pebble",
        "icon": "$(clear-all)"
      },
      {
        "command": "pebble.openChat",
        "title": "Apri il mentor",
        "category": "Pebble",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "pebble.path.refresh",
        "title": "Ricarica il percorso",
        "category": "Pebble",
        "icon": "$(refresh)"
      },
      {
        "command": "pebble.path.open",
        "title": "Apri percorso.md",
        "category": "Pebble",
        "icon": "$(go-to-file)"
      },
      {
        "command": "pebble.path.createExample",
        "title": "Crea un percorso di esempio",
        "category": "Pebble"
      },
      {
        "command": "pebble.path.reveal",
        "title": "Apri il compito nel percorso",
        "category": "Pebble"
      },
      {
        "command": "pebble.path.verify",
        "title": "Verifica il percorso con test e compilatore",
        "category": "Pebble",
        "icon": "$(beaker)"
      },
      {
        "command": "pebble.helpHere",
        "title": "Pebble, aiutami qui",
        "category": "Pebble"
      },
      {
        "command": "pebble.help.reply",
        "title": "Rispondi"
      },
      {
        "command": "pebble.help.up",
        "title": "Più concreto"
      },
      {
        "command": "pebble.help.why",
        "title": "Perché conta?"
      },
      {
        "command": "pebble.help.deep",
        "title": "Approfondisci"
      },
      {
        "command": "pebble.help.close",
        "title": "Ho capito",
        "icon": "$(check)"
      },
      {
        "command": "pebble.path.planNext",
        "title": "Prepara il prossimo passo del percorso",
        "category": "Pebble"
      },
      {
        "command": "pebble.scaffoldFile",
        "title": "Prepara il file: firme e pseudocodice",
        "category": "Pebble"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pebble.helpHere",
          "group": "pebble@0"
        },
        {
          "command": "pebble.reviewFile",
          "group": "pebble"
        }
      ],
      "view/title": [
        {
          "command": "pebble.path.verify",
          "when": "view == pebble.path && pebble.hasPath",
          "group": "navigation@0"
        },
        {
          "command": "pebble.clearChat",
          "when": "view == pebble.chat",
          "group": "navigation@1"
        },
        {
          "command": "pebble.openSettings",
          "when": "view == pebble.chat",
          "group": "navigation@2"
        },
        {
          "command": "pebble.path.open",
          "when": "view == pebble.path && pebble.hasPath",
          "group": "navigation@1"
        },
        {
          "command": "pebble.path.refresh",
          "when": "view == pebble.path",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "pebble.path.reveal",
          "when": "false"
        },
        {
          "command": "pebble.help.reply",
          "when": "false"
        },
        {
          "command": "pebble.help.up",
          "when": "false"
        },
        {
          "command": "pebble.help.why",
          "when": "false"
        },
        {
          "command": "pebble.help.deep",
          "when": "false"
        },
        {
          "command": "pebble.help.close",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "pebble.help.reply",
          "group": "inline@1",
          "when": "commentController == pebble.help"
        },
        {
          "command": "pebble.help.up",
          "group": "inline@2",
          "when": "commentController == pebble.help"
        },
        {
          "command": "pebble.help.why",
          "group": "inline@3",
          "when": "commentController == pebble.help"
        },
        {
          "command": "pebble.help.deep",
          "group": "inline@4",
          "when": "commentController == pebble.help"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "pebble.help.close",
          "group": "inline",
          "when": "commentController == pebble.help"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pebble.reviewFile",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus"
      },
      {
        "command": "pebble.helpHere",
        "key": "alt+p",
        "mac": "alt+p",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Pebble",
      "properties": {
        "pebble.language": {
          "type": "string",
          "enum": [
            "auto",
            "it",
            "en"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Segue la lingua di VS Code (italiano se VS Code è in italiano, altrimenti inglese) · Follows VS Code's language",
            "Italiano",
            "English"
          ],
          "markdownDescription": "Lingua di Pebble: interfaccia, testi che scrive (percorso, scheletri, bootstrap) e risposte del modello. · Pebble's language: interface, the texts it writes and the model's answers."
        },
        "pebble.experienceLevel": {
          "type": "string",
          "enum": [
            "entry",
            "junior",
            "mid",
            "senior"
          ],
          "enumDescriptions": [
            "Sto imparando a programmare: spiegazioni semplici, termini spiegati, passi concreti",
            "Programmo ma ho poca esperienza di progetto: il perché, con il nome dei principi",
            "Sono autonomo: comportamento predefinito",
            "Esperto: solo bug, violazioni degli ADR e trade-off, risposte asciutte"
          ],
          "default": "mid",
          "description": "Il tuo livello di esperienza: cambia cosa segnala Pebble e come lo spiega."
        },
        "pebble.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "local"
          ],
          "enumDescriptions": [
            "Claude, via API di Anthropic",
            "OpenAI",
            "Modello locale con API compatibile OpenAI (Ollama, LM Studio, llama.cpp)"
          ],
          "default": "anthropic",
          "description": "Quale modello usa Pebble per le review."
        },
        "pebble.anthropic.model": {
          "type": "string",
          "default": "claude-opus-5-5",
          "description": "Modello Claude."
        },
        "pebble.anthropic.effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "default": "medium",
          "description": "Quanto ragiona Claude: più alto = review più accurate, più lente e più costose."
        },
        "pebble.openai.model": {
          "type": "string",
          "default": "",
          "description": "Modello OpenAI da usare (obbligatorio se il provider è OpenAI)."
        },
        "pebble.local.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "description": "Indirizzo dell'API compatibile OpenAI del server locale. Ollama: http://localhost:11434/v1 · LM Studio: http://localhost:1234/v1"
        },
        "pebble.local.model": {
          "type": "string",
          "default": "",
          "description": "Nome del modello locale (es. quello che vedi con `ollama list`)."
        },
        "pebble.monthlyBudgetUsd": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Budget mensile in dollari. Superato il budget, Pebble ti avvisa e la barra di stato diventa gialla. 0 = nessun budget."
        },
        "pebble.prices": {
          "type": "object",
          "default": {},
          "markdownDescription": "Prezzi per i modelli non noti a Pebble (es. OpenAI), in dollari per milione di token. Esempio: `{ \"gpt-6.2-sol\": { \"input\": 2, \"output\": 8, \"cacheRead\": 0.2 } }`. I prezzi dei modelli Claude sono già inclusi.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input": {
                "type": "number"
              },
              "output": {
                "type": "number"
              },
              "cacheRead": {
                "type": "number"
              },
              "cacheWrite": {
                "type": "number"
              }
            },
            "required": [
              "input",
              "output"
            ]
          }
        },
        "pebble.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Quando apri un progetto con bootstrap.md ma senza .pebble/, Pebble lo legge da solo e propone il piano (una volta per progetto)."
        },
        "pebble.guideNewFiles": {
          "type": "boolean",
          "default": true,
          "description": "Quando crei un file in un progetto con .pebble/, Pebble ti dice che ruolo ha e cosa evitare."
        },
        "pebble.path.testCommand": {
          "type": "string",
          "default": "node --test --test-reporter=tap",
          "markdownDescription": "Comando che lancia i test e stampa i risultati in formato TAP, eseguito nella cartella del progetto. Esempi: `node --test --test-reporter=tap \"test/**/*.test.ts\"`, `npx vitest run --reporter=tap`."
        },
        "pebble.path.testTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "description": "Tempo massimo per i test lanciati dal percorso, in secondi."
        },
        "pebble.path.verifyOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Quando salvi un file del progetto, rilancia i test e aggiorna le caselle del percorso. Non usa il modello e non costa niente."
        },
        "pebble.path.requireRedFirst": {
          "type": "boolean",
          "default": false,
          "description": "Un compito si chiude solo se Pebble ha visto i suoi test fallire almeno una volta (ADR-010). Disattivato: il compito si chiude con un avviso."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pebble",
          "title": "Pebble",
          "icon": "media/pebble.svg"
        }
      ]
    },
    "views": {
      "pebble": [
        {
          "id": "pebble.path",
          "name": "Percorso",
          "type": "webview"
        },
        {
          "type": "webview",
          "id": "pebble.chat",
          "name": "Mentor"
        }
      ]
    }
  },
  "scripts": {
    "sync-prompt": "node scripts/sync-prompt.mjs",
    "build": "npm run sync-prompt && tsc --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --minify --outfile=dist/extension.js",
    "test": "tsc -p tsconfig.test.json && node --test \"out-test/test/*.test.js\"",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "marked": "^18.2.1",
    "openai": "^7.62.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
