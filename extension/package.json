{
  "name": "pebble-code-companion",
  "displayName": "Pebble · Code Path Companion",
  "description": "%description%",
  "version": "0.7.23",
  "publisher": "lofrance",
  "preview": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LordKenzo/pebble-code-companion.git",
    "directory": "extension"
  },
  "homepage": "https://github.com/LordKenzo/pebble-code-companion#readme",
  "bugs": {
    "url": "https://github.com/LordKenzo/pebble-code-companion/issues"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#121624",
    "theme": "dark"
  },
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In modalità con restrizioni Pebble funziona (percorso, fumetto, review), ma non lancia il comando dei test: eseguirebbe codice della cartella. Considera attendibile la cartella per far spuntare i compiti in automatico.",
      "restrictedConfigurations": [
        "pebble.path.testCommand"
      ]
    },
    "virtualWorkspaces": false
  },
  "categories": [
    "Linters",
    "Education",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pebble.start",
        "title": "%command.start%",
        "category": "Pebble"
      },
      {
        "command": "pebble.reviewFile",
        "title": "%command.reviewFile%",
        "category": "Pebble"
      },
      {
        "command": "pebble.setApiKey",
        "title": "%command.setApiKey%",
        "category": "Pebble"
      },
      {
        "command": "pebble.clearReview",
        "title": "%command.clearReview%",
        "category": "Pebble"
      },
      {
        "command": "pebble.openSettings",
        "title": "%command.openSettings%",
        "category": "Pebble",
        "icon": "$(gear)"
      },
      {
        "command": "pebble.setLevel",
        "title": "%command.setLevel%",
        "category": "Pebble"
      },
      {
        "command": "pebble.showSpend",
        "title": "%command.showSpend%",
        "category": "Pebble"
      },
      {
        "command": "pebble.resetSpend",
        "title": "%command.resetSpend%",
        "category": "Pebble"
      },
      {
        "command": "pebble.init",
        "title": "%command.init%",
        "category": "Pebble"
      },
      {
        "command": "pebble.next",
        "title": "%command.next%",
        "category": "Pebble"
      },
      {
        "command": "pebble.tests",
        "title": "%command.tests%",
        "category": "Pebble"
      },
      {
        "command": "pebble.clearChat",
        "title": "%command.clearChat%",
        "category": "Pebble",
        "icon": "$(clear-all)"
      },
      {
        "command": "pebble.openChat",
        "title": "%command.openChat%",
        "category": "Pebble",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "pebble.path.refresh",
        "title": "%command.path.refresh%",
        "category": "Pebble",
        "icon": "$(refresh)"
      },
      {
        "command": "pebble.path.open",
        "title": "%command.path.open%",
        "category": "Pebble",
        "icon": "$(go-to-file)"
      },
      {
        "command": "pebble.path.createExample",
        "title": "%command.path.createExample%",
        "category": "Pebble"
      },
      {
        "command": "pebble.path.reveal",
        "title": "%command.path.reveal%",
        "category": "Pebble"
      },
      {
        "command": "pebble.path.verify",
        "title": "%command.path.verify%",
        "category": "Pebble",
        "icon": "$(beaker)"
      },
      {
        "command": "pebble.helpHere",
        "title": "%command.helpHere%",
        "category": "Pebble"
      },
      {
        "command": "pebble.help.reply",
        "title": "%command.help.reply%"
      },
      {
        "command": "pebble.help.up",
        "title": "%command.help.up%"
      },
      {
        "command": "pebble.help.why",
        "title": "%command.help.why%"
      },
      {
        "command": "pebble.help.deep",
        "title": "%command.help.deep%"
      },
      {
        "command": "pebble.help.close",
        "title": "%command.help.close%",
        "icon": "$(check)"
      },
      {
        "command": "pebble.path.planNext",
        "title": "%command.path.planNext%",
        "category": "Pebble"
      },
      {
        "command": "pebble.scaffoldFile",
        "title": "%command.scaffoldFile%",
        "category": "Pebble"
      },
      {
        "command": "pebble.map.open",
        "title": "%command.map.open%",
        "category": "Pebble",
        "icon": "$(map)"
      },
      {
        "command": "pebble.map.reviewStep",
        "title": "%command.map.reviewStep%",
        "category": "Pebble"
      },
      {
        "command": "pebble.adopt",
        "title": "%command.adopt%",
        "category": "Pebble"
      },
      {
        "command": "pebble.newFeature",
        "title": "%command.newFeature%",
        "category": "Pebble",
        "icon": "$(add)"
      },
      {
        "command": "pebble.newBug",
        "title": "%command.newBug%",
        "category": "Pebble",
        "icon": "$(bug)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "pebble.helpHere",
          "group": "pebble@0"
        },
        {
          "command": "pebble.reviewFile",
          "group": "pebble"
        }
      ],
      "view/title": [
        {
          "command": "pebble.map.open",
          "when": "view == pebble.path && pebble.hasPath",
          "group": "navigation@0"
        },
        {
          "command": "pebble.path.verify",
          "when": "view == pebble.path && pebble.hasPath",
          "group": "navigation@0"
        },
        {
          "command": "pebble.clearChat",
          "when": "view == pebble.chat",
          "group": "navigation@1"
        },
        {
          "command": "pebble.openSettings",
          "when": "view == pebble.chat",
          "group": "navigation@2"
        },
        {
          "command": "pebble.path.open",
          "when": "view == pebble.path && pebble.hasPath",
          "group": "navigation@1"
        },
        {
          "command": "pebble.path.refresh",
          "when": "view == pebble.path",
          "group": "navigation@2"
        },
        {
          "command": "pebble.newFeature",
          "when": "view == pebble.path",
          "group": "1_paths@1"
        },
        {
          "command": "pebble.newBug",
          "when": "view == pebble.path",
          "group": "1_paths@2"
        }
      ],
      "commandPalette": [
        {
          "command": "pebble.path.reveal",
          "when": "false"
        },
        {
          "command": "pebble.help.reply",
          "when": "false"
        },
        {
          "command": "pebble.help.up",
          "when": "false"
        },
        {
          "command": "pebble.help.why",
          "when": "false"
        },
        {
          "command": "pebble.help.deep",
          "when": "false"
        },
        {
          "command": "pebble.help.close",
          "when": "false"
        },
        {
          "command": "pebble.map.reviewStep",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "pebble.help.reply",
          "group": "inline@1",
          "when": "commentController == pebble.help"
        },
        {
          "command": "pebble.help.up",
          "group": "inline@2",
          "when": "commentController == pebble.help"
        },
        {
          "command": "pebble.help.why",
          "group": "inline@3",
          "when": "commentController == pebble.help"
        },
        {
          "command": "pebble.help.deep",
          "group": "inline@4",
          "when": "commentController == pebble.help"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "pebble.help.close",
          "group": "inline",
          "when": "commentController == pebble.help"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pebble.reviewFile",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus"
      },
      {
        "command": "pebble.helpHere",
        "key": "alt+p",
        "mac": "alt+p",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Pebble",
      "properties": {
        "pebble.language": {
          "type": "string",
          "enum": [
            "auto",
            "it",
            "en"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.language.enum0%",
            "%config.language.enum1%",
            "%config.language.enum2%"
          ],
          "markdownDescription": "%config.language%"
        },
        "pebble.experienceLevel": {
          "type": "string",
          "enum": [
            "entry",
            "junior",
            "mid",
            "senior"
          ],
          "enumDescriptions": [
            "%config.experienceLevel.enum0%",
            "%config.experienceLevel.enum1%",
            "%config.experienceLevel.enum2%",
            "%config.experienceLevel.enum3%"
          ],
          "default": "mid",
          "description": "%config.experienceLevel%"
        },
        "pebble.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "local"
          ],
          "enumDescriptions": [
            "%config.provider.enum0%",
            "%config.provider.enum1%",
            "%config.provider.enum2%"
          ],
          "default": "anthropic",
          "description": "%config.provider%"
        },
        "pebble.anthropic.model": {
          "type": "string",
          "default": "claude-opus-5-5",
          "description": "%config.anthropic.model%"
        },
        "pebble.anthropic.effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "default": "medium",
          "description": "%config.anthropic.effort%"
        },
        "pebble.openai.model": {
          "type": "string",
          "default": "",
          "description": "%config.openai.model%"
        },
        "pebble.local.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "description": "%config.local.baseUrl%"
        },
        "pebble.local.model": {
          "type": "string",
          "default": "",
          "description": "%config.local.model%"
        },
        "pebble.monthlyBudgetUsd": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%config.monthlyBudgetUsd%"
        },
        "pebble.prices": {
          "type": "object",
          "default": {},
          "markdownDescription": "%config.prices%",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input": {
                "type": "number"
              },
              "output": {
                "type": "number"
              },
              "cacheRead": {
                "type": "number"
              },
              "cacheWrite": {
                "type": "number"
              }
            },
            "required": [
              "input",
              "output"
            ]
          }
        },
        "pebble.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoStart%"
        },
        "pebble.guideNewFiles": {
          "type": "boolean",
          "default": true,
          "description": "%config.guideNewFiles%"
        },
        "pebble.path.testCommand": {
          "type": "string",
          "default": "node --test --test-reporter=tap",
          "markdownDescription": "%config.path.testCommand%"
        },
        "pebble.path.testTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "description": "%config.path.testTimeoutSeconds%"
        },
        "pebble.path.verifyOnSave": {
          "type": "boolean",
          "default": true,
          "description": "%config.path.verifyOnSave%"
        },
        "pebble.path.requireRedFirst": {
          "type": "boolean",
          "default": false,
          "description": "%config.path.requireRedFirst%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pebble",
          "title": "Pebble",
          "icon": "media/pebble.svg"
        }
      ]
    },
    "views": {
      "pebble": [
        {
          "id": "pebble.path",
          "name": "%view.path%",
          "type": "webview"
        },
        {
          "type": "webview",
          "id": "pebble.chat",
          "name": "%view.chat%"
        }
      ]
    }
  },
  "scripts": {
    "sync-prompt": "node scripts/sync-prompt.mjs",
    "build": "npm run sync-prompt && tsc --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --minify --outfile=dist/extension.js",
    "test": "tsc -p tsconfig.test.json && node --test \"out-test/test/*.test.js\"",
    "package": "npm run build && vsce package --no-dependencies",
    "publish:pre": "npm run build && vsce publish --pre-release --no-dependencies",
    "package:pre": "npm run build && vsce package --pre-release --no-dependencies"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "marked": "^18.2.1",
    "openai": "^7.62.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "learning",
    "mentor",
    "tdd",
    "tests",
    "pair programming",
    "code review",
    "ai",
    "education"
  ]
}
